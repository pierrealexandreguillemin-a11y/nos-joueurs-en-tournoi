# Neon Postgres - sync multi-appareils (schema : db/schema.sql)
# Provisionne via Vercel Marketplace (Storage > nos-joueurs-en-tournoi-db), prefixe "DATABASE".
# Injecte automatiquement en Production/Preview. Valeur marquee "sensitive" : non recuperable
# par `vercel env pull` ; pour un usage local, copier la connection string depuis la console Neon.
DATABASE_URL=

# HMAC sync token secret (protects /api/events/* against casual cross-origin abuse)
# NOTE: NEXT_PUBLIC_ prefix exposes this in the client bundle — by design,
# since tokens are generated client-side. Not a substitute for server-side auth.
NEXT_PUBLIC_SYNC_SECRET=

# GitHub (pour Claude Code Web)
# Ces valeurs permettent à Claude Code Web de synchroniser avec votre repo
# Obtenir depuis: https://github.com/settings/tokens (Personal access tokens > Tokens classic)
# Permissions requises: repo (Full control of private repositories)

GITHUB_TOKEN=

# Vercel (pour déploiements depuis Claude Code Web)
# Obtenir depuis: https://vercel.com/account/tokens
VERCEL_TOKEN=

# Project Info (pour Claude Code Web)
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
